Bootstrap: docker
From: ubuntu:24.04

%post
    set -eux
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget git \
        build-essential pkg-config bzip2
    rm -rf /var/lib/apt/lists/*

    # Ubuntu 24.04 does not provide python3.10 apt packages by default.
    # Install Miniforge and pin Python 3.10 for project compatibility.
    wget -qO /tmp/miniforge.sh \
      https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh
    bash /tmp/miniforge.sh -b -p /opt/conda
    rm -f /tmp/miniforge.sh

    /opt/conda/bin/conda install -y python=3.10 pip
    /opt/conda/bin/conda clean -afy

    # Make python command predictable
    ln -sf /opt/conda/bin/python /usr/local/bin/python
    ln -sf /opt/conda/bin/python /usr/local/bin/python3
    ln -sf /opt/conda/bin/pip /usr/local/bin/pip
    ln -sf /opt/conda/bin/pip /usr/local/bin/pip3

%environment
    export PATH=/opt/conda/bin:$PATH
    export PYTHONUNBUFFERED=1
    export PIP_DISABLE_PIP_VERSION_CHECK=1

%runscript
    exec "$@"
